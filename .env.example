# Groq API key — server-side only. Never expose to the browser bundle.
GROQ_API_KEY=

# Model is configurable; do not hardcode it in application code.
GROQ_MODEL=llama-3.3-70b-versatile

# Speech-to-text model, used only for browsers without the Web Speech API.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Port for the API server that proxies Groq.
API_PORT=8787
