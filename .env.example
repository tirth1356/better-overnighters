# Groq API key — server-side only. Never expose to the browser bundle.
GROQ_API_KEY=

# Groq Model (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Speech-to-text model, used only for browsers without the Web Speech API.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Neon SQL Database Connection (PostgreSQL connection string)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=

# Port for the API server that proxies Groq and records API.
API_PORT=8787
